# Flask Configuration & Security
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
# Generate a secure key in production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-this-in-production-to-a-secure-random-secret
SESSION_COOKIE_SECURE=False

# SQLite Configuration
DATABASE_PATH=college_assistant.db

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=768
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=2

# Cache Configuration
CACHE_TTL_SECONDS=86400

# Application Settings
PROMPT_VERSION=v2.0
MAX_HISTORY_TURNS=4
MAX_MESSAGE_LENGTH=4000
WEB_SEARCH_ENABLED=False
